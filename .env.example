# .env.example — copy this to .env and fill in real values before running docker compose
#
# NEVER commit the actual .env file to version control.
# This .env.example file is safe to commit — it contains no real secrets.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual values
#   docker compose up --build

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change_me_before_production

# ── Application ────────────────────────────────────────────────────────────────
# The JDBC URL must match the service name in docker-compose.yml ("db")
DATABASE_URL=jdbc:postgresql://db:5432/urlshortener
DATABASE_USER=urlshortener
DATABASE_PASSWORD=change_me_before_production

# Public-facing base URL used when constructing shortened URLs in API responses.
# In production, replace with your actual domain (e.g. https://short.example.com)
APP_BASE_URL=http://localhost:8080
